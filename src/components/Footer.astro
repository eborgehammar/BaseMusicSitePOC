---
import { site } from '../config/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-surface">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between"
  >
    <div>
      <p class="font-serif text-lg">{site.name}</p>
      <p class="text-sm text-muted">{site.tagline}</p>
    </div>
    <SocialLinks />
  </div>
  <p class="border-t border-line px-4 py-4 text-center text-xs text-muted">
    © {year} {site.name}. All rights reserved.
  </p>
</footer>
