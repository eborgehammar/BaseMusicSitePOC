---
interface Props {
  name: string;
  price: string;
  period?: string;
  features: string[];
  highlight?: boolean;
}

const { name, price, period, features, highlight = false } = Astro.props;
---

<article
  class:list={[
    'flex flex-col rounded-2xl border p-8',
    highlight ? 'border-accent bg-surface' : 'border-line bg-ivory',
  ]}
>
  <h3 class="text-2xl">{name}</h3>
  <p class="mt-4 font-serif text-4xl">
    {price}
    {period && <span class="font-sans text-base text-muted">{period}</span>}
  </p>
  <ul class="mt-6 flex-1 space-y-3 text-sm text-muted">
    {features.map((feature) => <li>{feature}</li>)}
  </ul>
</article>
