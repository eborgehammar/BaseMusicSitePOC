---
import BaseLayout from '../layouts/BaseLayout.astro';
import { policies, programs, tuition } from '../content/lessons';
---

<BaseLayout title="Lessons" description="Piano lesson programs, tuition, and studio policies.">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-4xl md:text-5xl">Lessons</h1>
    <p class="mt-6 max-w-prose text-lg text-muted">
      Placeholder: a short introduction to the studio and how lessons are structured.
    </p>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-3xl">Programs</h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          programs.map((program) => (
            <li class="rounded-2xl border border-line bg-ivory p-6">
              <h3 class="text-xl">{program.title}</h3>
              <p class="mt-3 text-sm text-muted">{program.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line bg-surface">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-16 sm:px-6 md:grid-cols-2">
      <div>
        <h2 class="text-3xl">Tuition</h2>
        <table class="mt-6 w-full text-left text-sm">
          <thead class="border-b border-line text-muted">
            <tr>
              <th scope="col" class="py-3 font-medium">Lesson length</th>
              <th scope="col" class="py-3 text-right font-medium">Price</th>
            </tr>
          </thead>
          <tbody>
            {
              tuition.map((row) => (
                <tr class="border-b border-line">
                  <td class="py-3">{row.length}</td>
                  <td class="py-3 text-right font-medium">{row.price}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div>
        <h2 class="text-3xl">Policies</h2>
        <ul class="mt-6 space-y-3 text-muted">
          {policies.map((policy) => <li>{policy}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
